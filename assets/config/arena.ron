        (14.8, 0, 0.7), (-14.8, 0, 0.7), (0, 14.8, 0.7),
    ],
    player_spawn: (0, -26),
    boss_spawn: (0, 6),
    corridor_half_width: 1.6,
    corridor_end: -30,
