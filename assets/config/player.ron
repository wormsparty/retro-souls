// Player tuning. Durations in ticks (60/s), speeds in m/s.
// Hot-reloaded on native with `cargo run --features dev`.
(
    max_hp: 500,
    max_stamina: 120,
    // Attack cost = damage × this factor (the same for all weapons).
    stamina_per_damage: 0.28,
    // Stamina can go negative; at least 1 point is needed to act.
    stamina_floor: -60,
    stamina_regen: 55,
    stamina_regen_guarding: 22,
    stamina_delay: 30,
    run_speed: 4.2,
    sprint_speed: 6.4,
    sprint_stamina: 16,
    sprint_hold: 14,
    accel: 30,
    turn_rate: 720,
    // Jump (A / G when there's nothing to pick up and no brazier in range): ~0.8 m high,
    // ~0.55 s in the air, i.e. ~3.5 m cleared while running (~2.3 m at a jog).
    jump: (speed: 6.0, stamina: 12, air_control: 6),
    radius: 0.4,
    height: 1.8,
    lock_range: 25,
    input_buffer: 10,
    regain_ticks: 360,
    regain_ratio: 0.6,
    // Special gauge: full = special ready, it empties when used. Fills by dealing damage
    // (not with the special itself nor a fatal blow) and with perfect guards.
    special_max: 200,
    special_per_damage: 0.3,
    fatal_range: 2.2,
    fatal_arc: 70,

    guard: (
        // ~133 ms: guard pressed at most 8 ticks before the impact.
        perfect_window: 8,
        spam_window: 20,
        spam_penalty: 2,
        min_window: 3,
        damage_ratio: 0.6,
        stamina_ratio: 0.45,
        perfect_stagger: 14,
        perfect_special: 12,
        perfect_hitstop: 7,
        arc: 100,
        walk_speed: 1.8,
    ),

    // Roll: ~3.5 m (fast burst then slide), enough to get out of an area effect.
    dodge: (
        anim: "dodge",
        total: 30,
        iframes: (2, 16),
        motion: [(start: 0, end: 15, speed: 11.5), (start: 15, end: 23, speed: 4.5)],
        stamina: 22,
        chain_from: 24,
        cancel_from: 22,
    ),
    backstep: (
        anim: "backstep",
        total: 22,
        iframes: (1, 10),
        motion: [(start: 0, end: 12, speed: -8.5)],
        stamina: 15,
        chain_from: 15,
    ),
    guard_hit: (
        anim: "guard_hit",
        total: 16,
        motion: [(start: 0, end: 6, speed: -2.0)],
        chain_from: 10,
        cancel_from: 8,
    ),
    perfect_guard: (
        anim: "perfect_guard",
        total: 14,
        chain_from: 3,
        cancel_from: 3,
    ),
    guard_break: (
        anim: "guard_break",
        total: 60,
        motion: [(start: 0, end: 10, speed: -2.5)],
        cancel_from: 50,
    ),
    hit_light: (
        anim: "hit_light",
        total: 26,
        motion: [(start: 0, end: 8, speed: -2.5)],
        cancel_from: 20,
    ),
    hit_heavy: (
        anim: "hit_heavy",
        total: 80,
        // Invulnerable during the fall and the getting up.
        iframes: (6, 70),
        motion: [(start: 0, end: 18, speed: -5.0)],
        cancel_from: 66,
    ),
    switch: (
        anim: "switch",
        total: 24,
        chain_from: 22,
        cancel_from: 14,
    ),
    switch_at: 12,
    death: (
        anim: "death",
        total: 90,
    ),

    // Heals: 3 charges (refilled at the checkpoint), Lies of P style.
    heal_charges: 3,
    heal_ratio: 0.4,
    // The heal applies on this tick: hit before it, the charge is lost.
    heal_at: 24,
    heal: (
        anim: "heal",
        total: 42,
        walk: 1.3,
        chain_from: 36,
        cancel_from: 34,
    ),
)
