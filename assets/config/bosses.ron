// Les autres boss (l'Automate est dans boss.ron), et les rencontres proposées au checkpoint.
// Même format que boss.ron, avec en plus :
//
// - model / scale / tint : modèle (assets/models/<model>.glb, tools/blender/trial_bosses.py),
//   son échelle et une teinte. Toutes les distances (capsules, parties, sorts) sont en mètres
//   dans le jeu, donc à l'échelle du modèle.
// - minor : second rôle (les chiens du boucher) : petite barre au-dessus de lui, et sa mort
//   n'est pas nécessaire à la victoire. Quand un premier rôle tombe, l'autre passe en phase 2.
// - keep_away : en deçà, il recule (lanceur de sorts).
// - parts : zones touchables en plus du corps, et points qu'on peut verrouiller (stick droit
//   ou souris pour passer de l'un à l'autre). `bone` : l'objet du modèle que suit le réticule.
// - spells : sorts lancés par les `casts` des attaques. Bolt : projectile (speed, homing en
//   degrés/s, life en ticks, delay : ticks suspendu là où il apparaît avant de partir vers sa cible) ;
//   s'il s'écrase au sol, il y brûle encore un moment. Eruption : colonne qui jaillit du sol après `delay` ticks
//   d'alerte (zone marquée au sol), et dure `life` ticks ; ni garde ni parade.
//   Beam : jet continu de la bouche jusqu'au sol, qu'il touche à `reach` (min, max) mètres
//   devant la bouche selon la cible au lancer ; il suit le lanceur pendant `life` ticks.
//   Les sorts d'une même attaque ne touchent qu'une fois.
// - casts : (at: tick, spell, from: point de départ local, aim: Target | Forward | Ring,
//   count, spread : éventail en degrés (projectiles) ou rayon en mètres (éruptions),
//   step : écart des éruptions en ligne, delay_step : retard de chaque éruption sur la précédente).
// - min_angle : attaque vers l'arrière (coup de queue) : la cible doit être au moins à cet angle.
// - side : Left | Right, côté où doit se trouver la cible (pivots).
// - motion.turn : rotation sur place pendant le segment (degrés, positif = vers la gauche).
// - heading_slack : grande bête qui ne vise pas exactement sa cible (degrés de tolérance) ;
//   elle ne se tourne que quand la cible sort de ce cône, et n'avance que face à elle.
(
    encounters: [
        (name: (en: "The Ash Wyrm", fr: "La Wyverne de Cendre"), embers: 2400,
         members: [(boss: "dragon", offset: (0, 1))]),
        (name: (en: "The Horned Butcher", fr: "Le Boucher Cornu"), embers: 1600,
         members: [(boss: "butcher"), (boss: "butcher_hound", offset: (-3, -2.5)), (boss: "butcher_hound", offset: (3, -2))]),
        (name: (en: "The Lamplighter and the Anvil", fr: "L'Allumeur et l'Enclume"), embers: 2000,
         members: [(boss: "lamplighter", offset: (-3, 1.5)), (boss: "anvil", offset: (2.6, 0))]),
        (name: (en: "The Great Marionette", fr: "La Grande Marionnette"), embers: 1800,
         members: [(boss: "marionette", offset: (0, 0.5))]),
        (name: (en: "The Hollow-Spined Beast", fr: "La Bête à l'Échine Creuse"), embers: 2000,
         members: [(boss: "spine_beast", offset: (0, 1))]),
        (name: (en: "The Flame-Bearing Giant", fr: "Le Géant Porte-Flamme"), embers: 2600,
         members: [(boss: "giant", offset: (0, 2))]),
    ],

    bosses: [
        // ================================================================= wyverne de cendre
        // Immense : on verrouille sa tête, ses pattes ou sa queue. Elle ne vise pas : c'est une
        // grosse bête qui avance à peu près vers sa proie. Devant elle, coup de tête ou plaquage ;
        // sur son flanc, elle pivote d'un quart de tour en fouettant de la queue ; derrière, la
        // queue balaie. De loin, un jet de feu ; en phase 2, elle s'envole.
