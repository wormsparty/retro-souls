// Movesets des armes. Repère local : x = droite, y = haut, z = avant.
// Endurance : sans `stamina` explicite, une attaque coûte ses dégâts totaux × `stamina_per_damage`
// (player.ron) : à dégâts égaux, rapière et greatsword coûtent la même chose.
// `arc: (début, fin)` fait tourner la capsule autour de l'axe vertical (positif = vers la gauche).
(
    weapons: [
        // ------------------------------------------------------------------ Rapière
        (
            name: (en: "Rapier", fr: "Rapière"),
            light: [
                (
                    anim: "rapier_light1", total: 24,
                    track_until: 7, track_rate: 540,
                    chain_from: 13, cancel_from: 12,
                    motion: [(start: 3, end: 9, speed: 2.2)],
                    hits: [(start: 8, end: 11, damage: 32, stagger: 3, hitstop: 3,
                            capsule: (a: (0.15, 1.25, 0.4), b: (0.1, 1.25, 1.75), r: 0.14))],
                ),
                (
                    anim: "rapier_light2", total: 24,
                    track_until: 6, track_rate: 540,
                    chain_from: 12, cancel_from: 12,
                    motion: [(start: 2, end: 8, speed: 2.2)],
                    hits: [(start: 7, end: 10, damage: 32, stagger: 3, hitstop: 3,
                            capsule: (a: (0.1, 1.1, 0.4), b: (0.0, 1.15, 1.75), r: 0.14))],
                ),
                (
                    anim: "rapier_light3", total: 26,
                    track_until: 6, track_rate: 540,
                    chain_from: 14, cancel_from: 13,
                    motion: [(start: 2, end: 9, speed: 2.6)],
                    hits: [(start: 8, end: 12, damage: 34, stagger: 4, hitstop: 3,
                            arc: (-35, 35),
                            capsule: (a: (0.0, 1.2, 0.4), b: (0.0, 1.2, 1.6), r: 0.14))],
                ),
                (
                    anim: "rapier_light4", total: 36,
                    track_until: 10, track_rate: 480,
                    chain_from: 24, cancel_from: 20,
                    motion: [(start: 6, end: 13, speed: 4.5)],
                    hits: [(start: 12, end: 15, damage: 46, stagger: 7, hitstop: 4,
                            capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 1.95), r: 0.15))],
                ),
            ],
            heavy: (
                anim: "rapier_heavy", total: 40,
                track_until: 12, track_rate: 420,
                chain_from: 30, cancel_from: 26,
                motion: [(start: 8, end: 16, speed: 6.0)],
                hits: [(start: 14, end: 18, damage: 58, stagger: 10, hitstop: 5,
                        capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.0), r: 0.16))],
            ),
            heavy_charged: (
                anim: "rapier_heavy_charged", total: 44,
                track_until: 6, track_rate: 420,
                chain_from: 32, cancel_from: 28,
                hyperarmor: (0, 14),
                motion: [(start: 2, end: 12, speed: 11.0)],
                hits: [(start: 8, end: 13, damage: 92, stagger: 26, hitstop: 7,
                        capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.2), r: 0.18))],
            ),
            charge_ticks: 36,
            charge_anim: "rapier_charge",
            // Fente éclair : dash puis rafale d'estocs. Coût d'endurance fixe, et ses coups ne
            // rechargent pas la jauge spéciale : elle doit valoir le segment dépensé à elle seule.
            special: (
                anim: "rapier_special", total: 62, stamina: 30,
                track_until: 8, track_rate: 600,
                hyperarmor: (0, 40),
                cancel_from: 50,
                motion: [(start: 4, end: 13, speed: 13.0), (start: 13, end: 38, speed: 0.8)],
                hits: [
                    (start: 13, end: 15, damage: 48, stagger: 7, hitstop: 3,
                     capsule: (a: (0.1, 1.3, 0.4), b: (0.0, 1.3, 1.8), r: 0.16)),
                    (start: 19, end: 21, damage: 48, stagger: 7, hitstop: 3,
                     capsule: (a: (0.1, 1.0, 0.4), b: (0.0, 1.0, 1.8), r: 0.16)),
                    (start: 25, end: 27, damage: 48, stagger: 7, hitstop: 3,
                     capsule: (a: (0.1, 1.4, 0.4), b: (0.0, 1.4, 1.8), r: 0.16)),
                    (start: 34, end: 38, damage: 120, stagger: 26, hitstop: 8,
                     capsule: (a: (0.1, 1.2, 0.4), b: (0.0, 1.2, 2.1), r: 0.2)),
                ],
            ),
            fatal: (
                anim: "rapier_fatal", total: 96, stamina: 0,
                iframes: (0, 96),
                hits: [(start: 46, end: 48, damage: 340, hitstop: 10,
                        capsule: (a: (0.0, 1.2, 0.3), b: (0.0, 1.4, 2.2), r: 0.35))],
            ),
        ),
        // ------------------------------------------------------------------ Greatsword
