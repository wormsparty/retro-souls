// The level around the arena: ruins hanging above the void.
//
// Frame: x, z on the ground (the arena is centred on (0, 0), its opening faces -z), y = height.
// - floors: walkable floors. `Ellipse` (square, platforms) or `Strip` (straight strip from
//   `from` to `to`, in (x, z, y): bridge, ramp, stairs). `walled`: walled edges (you bump into them);
//   otherwise, past the edge, it's the void and the fall. `arena`: the corridors to the bosses'
//   fogs (assets/config/arenas.ron), off-limits to path enemies. `sealed`: behind the final door.
//   Strips must go into the floors they connect, at the same height.
// - checkpoints: braziers. The first one is the starting point of a new game. `look`:
//   point you face when respawning there (the way forward).
// - props: decor (collisions are defined in code, `Prop::colliders`). No lit street lamp near a
//   boss torch: its coloured flame must be the only light around.
// - enemies: types defined in enemies.ron. They respawn on rest and on death, except
//   the `unique` ones. `group`: they raise the alarm together.
// - pickups: items glowing on the ground, picked up once and for all.
// - final_door: the door that opens once all the bosses are defeated (`pos`: its centre on the
//   ground, `look`: beyond it), and the sign that awaits behind it.
//
// The scenery (tools/blender/arena.py) is generated from this file: rerun
// tools/build_assets.sh after changing the geometry.
(
    floors: [
        // Landing in front of the theatre's fog (the Automaton), then stairs down to the square.
        (shape: Strip(from: (0, -16.2, 0), to: (0, -18.6, 0), half_width: 1.6), walled: true, arena: true),
        (shape: Strip(from: (0, -18.6, 0), to: (0, -23.4, -2.4), half_width: 1.6), walled: true, steps: 8),
        // Landing at the foot of the stairs: wider than them (their balustrades rest on it), it
        // starts under the last step; otherwise a corner of void remains between the end of the
        // balustrades and the edge of the square.
        (shape: Strip(from: (0, -23.0, -2.4), to: (0, -25.0, -2.4), half_width: 2.4)),
        // Lamplighters' Square.
        (shape: Ellipse(center: (0, -31.5), radii: (10, 8), y: -2.4)),
        // Bridge to the fountain garden (dead end east of the square).
        (shape: Strip(from: (8.5, -33.0, -2.4), to: (14.8, -33.6, -2.4), half_width: 1.2), style: Bridge),
        (shape: Ellipse(center: (18.8, -32.4), radii: (5.4, 6.0), y: -2.4)),
        // Corridor to the Lantern Foundry (the Wick-Trimmer and the Anvil).
        (shape: Strip(from: (22.6, -34.2, -2.4), to: (31.5, -35.0, -2.4), half_width: 1.2), walled: true, arena: true),
        // Bridge to the bandstand.
        (shape: Strip(from: (-3.5, -36.5, -2.4), to: (-9.6, -51.5, -2.4), half_width: 1.3), style: Bridge),
        (shape: Ellipse(center: (-10.5, -55), radii: (5, 5), y: -2.4)),
        // Corridor to the Slaughter Yard (the Knacker).
        (shape: Strip(from: (-14.0, -55.0, -2.4), to: (-23.0, -55.0, -2.4), half_width: 1.3), walled: true, arena: true),
        // Ramp to the ticket booths.
        (shape: Strip(from: (-8, -58.5, -2.4), to: (-1.4, -67, -4.0), half_width: 1.6), style: Bridge),
        (shape: Ellipse(center: (1, -71), radii: (7, 5.5), y: -4.0)),
        // Corridor to the Grand Guignol (the Great Marionette).
        (shape: Strip(from: (-5.5, -72.5, -4.0), to: (-15.0, -74.5, -4.0), half_width: 1.2), walled: true, arena: true),
        // Narrow walkway to a ledge, then a jump to a rock (flask shard).
        (shape: Strip(from: (6.5, -70.5, -4.0), to: (14.5, -68, -4.0), half_width: 0.55), style: Planks),
        (shape: Ellipse(center: (16.5, -67.5), radii: (2.2, 2.2), y: -4.0)),
        (shape: Ellipse(center: (21.4, -66.6), radii: (1.3, 1.3), y: -4.0)),
        // Long bridge to the track.
        (shape: Strip(from: (0.5, -75.5, -4.0), to: (5.7, -94.2, -5.2), half_width: 1.2), style: Bridge),
        (shape: Ellipse(center: (6.5, -99.5), radii: (6.5, 6.5), y: -5.2)),
        // Corridor to the Frozen Cistern (the Rimeback).
        (shape: Strip(from: (12.5, -99.5, -5.2), to: (21.5, -100.2, -5.2), half_width: 1.2), walled: true, arena: true),
        // Narrow plank to a ledge (talisman).
        (shape: Strip(from: (0.3, -101, -5.2), to: (-5.5, -103.5, -5.2), half_width: 0.4), style: Planks),
        (shape: Ellipse(center: (-7, -104), radii: (1.8, 1.8), y: -5.2)),
        // Stairs to the belvedere (second checkpoint).
        (shape: Strip(from: (8, -105.5, -5.2), to: (9.5, -112, -3.4), half_width: 1.4), steps: 7),
        (shape: Ellipse(center: (10, -116), radii: (4.2, 4.2), y: -3.4)),
        // Corridor to the Ash Summit (the Soot Wyvern).
        (shape: Strip(from: (6.0, -116.8, -3.4), to: (-3.0, -118.5, -3.4), half_width: 1.2), walled: true, arena: true),
        // An isolated rock east of the belvedere: you have to jump to it at a run (talisman).
        (shape: Ellipse(center: (18.4, -115.2), radii: (1.6, 1.6), y: -3.4)),
        // Bridge to the parvis: the Giant's corridor, and the final door.
        (shape: Strip(from: (10.5, -119.8, -3.4), to: (11.8, -129.5, -3.4), half_width: 1.2), style: Bridge),
        (shape: Ellipse(center: (12, -134.5), radii: (6.5, 5.5), y: -3.4)),
        // Corridor to the Giant's Hearth (the Dead-Hearth Giant).
        (shape: Strip(from: (17.6, -134.5, -3.4), to: (27.5, -135.5, -3.4), half_width: 1.3), walled: true, arena: true),
        // Porch of the final door, and beyond it, once it's open: a last terrace.
        (shape: Strip(from: (12, -138.5, -3.4), to: (12, -141.5, -3.4), half_width: 1.6), walled: true, arena: true),
        (shape: Strip(from: (12, -141.5, -3.4), to: (12, -147.0, -3.4), half_width: 1.6), walled: true, arena: true, sealed: true),
        (shape: Ellipse(center: (12, -151), radii: (4.2, 4.2), y: -3.4), walled: true, arena: true, sealed: true),
    ],

    checkpoints: [
        (
            name: (en: "Lamplighters' Square", fr: "Place des Allumeurs"),
            // Facing the stairs and the arena gate.
            pos: (-4.8, -29.0), look: (0, -17.0),
            view: ((-8.5, -0.3, -24.8), (-4.0, -1.4, -30.0)),
        ),
        (
            name: (en: "Broken Belvedere", fr: "Belvédère brisé"),
            // At the top of the stairs, away from the Wyvern's orange torch (its own light).
            // Facing the bridge to the parvis.
            pos: (12.0, -113.4), look: (12, -134.5),
            view: ((7.0, -1.5, -109.8), (12.4, -2.9, -114.6)),
        ),
    ],

    props: [
        // Square: two dead street lamps at the foot of the arena stairs (the theatre's torch is
        // there), a lit one at the start of the bridge.
        (kind: DeadLamp, pos: (4.3, -25.6), yaw: -120), (kind: DeadLamp, pos: (-4.3, -25.6), yaw: 100), (kind: Lamp, pos: (0, -38.3)),
        (kind: DeadLamp, pos: (-8.31, -29.74), yaw: -50),
        (kind: Bench, pos: (1.5, -37.8)), (kind: Bench, pos: (7.6, -29.2), yaw: -90),
        // Fountain garden: the fountain at the back, away from the Foundry's torch.
        (kind: Fountain, pos: (18.2, -29.2)),
        (kind: Bench, pos: (15.2, -30.4), yaw: 70),
        // Bandstand.
        (kind: Column, pos: (-6.7, -55.0)), (kind: Column, pos: (-7.81, -52.31)), (kind: Column, pos: (-13.19, -52.31)),
        (kind: Column, pos: (-13.19, -57.69)), (kind: Column, pos: (-10.5, -58.8)),
        (kind: Crates, pos: (-12.8, -52.2), yaw: 20),
        (kind: Lamp, pos: (-3.75, -62.0)),
        // Ticket booths.
        (kind: Booth, pos: (-2.8, -69.0), yaw: 30), (kind: Booth, pos: (3.2, -68.4), yaw: -20),
        (kind: Lamp, pos: (5.5, -74.2)), (kind: DeadLamp, pos: (-4.6, -69.4), yaw: 150),
        // Bridge.
        (kind: DeadLamp, pos: (1.1, -81.4), yaw: -60),
        // Track: a single street lamp, on the west side (the Cistern's torch is on the east side).
        (kind: Lamp, pos: (1.65, -96.7)),
        (kind: Crates, pos: (10.0, -95.0), yaw: -30),
        // Belvedere: on its north-west edge, between the stairs and the Wyvern's corridor, facing
        // the void.
        (kind: Bench, pos: (7.4, -113.8), yaw: -56),
        // Parvis.
        (kind: Lamp, pos: (8.0, -138.3)), (kind: DeadLamp, pos: (16.0, -138.3), yaw: 160),
    ],

    enemies: [
        // Bandstand: two sleeping dogs.
        (kind: "hound", pos: (-11.5, -54.0), yaw: 20, asleep: true, group: 1),
        (kind: "hound", pos: (-9.5, -56.5), yaw: 200, asleep: true, group: 1),
        // Ticket booths: a watching puppet, a slumped puppet and a dog.
        (kind: "puppet", pos: (2.0, -70.5), yaw: 0, group: 2),
        (kind: "puppet", pos: (-3.0, -72.5), yaw: 30, asleep: true, group: 2),
        (kind: "hound", pos: (4.5, -72.8), yaw: -20, asleep: true, group: 2),
        // Flask shard ledge: the dog waits until you're on the walkway.
        (kind: "hound", pos: (17.2, -67.0), yaw: 100, asleep: true, group: 3),
        // In the middle of the long bridge.
        (kind: "puppet", pos: (3.1, -84.85), yaw: -15.5),
        // Track: the colossus.
        (kind: "colossus", pos: (6.5, -99.0), yaw: -10, unique: true),
    ],

    pickups: [
        // Each one in sight, on its own, often guarded or at the brink: never right next to a
        // boss torch, a street lamp, nor at the start of a bridge.
        // Fountain garden: behind the fountain, at the edge of the void.
        (pos: (21.8, -28.4), items: [(FadedEmber, 1)]),
        // Bandstand: between the two sleeping dogs.
        (pos: (-10.3, -55.1), items: [(GoldenMoss, 2)]),
        // Ticket booths: at the east edge, past the sleeping dog.
        (pos: (6.4, -72.9), items: [(EmberResin, 2)]),
        // On the rock beyond the walkway, the ledge's dog in the way.
        (pos: (21.6, -66.7), items: [(FlaskShard, 1)]),
        // Long bridge: right behind the puppet that bars it.
        (pos: (3.4, -86.0), items: [(FadedEmber, 2)]),
        // Track: at its centre, at the colossus's feet.
        (pos: (6.5, -100.8), items: [(LivelyEmber, 1)]),
        // Isolated rock east of the belvedere (a running jump).
        (pos: (18.6, -115.3), items: [(IronBrooch, 1)]),
        // Ledge at the end of the narrow plank.
        (pos: (-7.6, -104.6), items: [(CrestPlume, 1)]),
    ],

    final_door: (pos: (12, -141.5), look: (12, -151)),
    sign: (12, -153.0),
)
